{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "RapidAPI Hub - Shazam Song Recognition API": {
      "type": "remote",
      "url": "https://mcp.rapidapi.com",
      "headers": {
        "x-api-host": "shazam-song-recognition-api.p.rapidapi.com",
        "x-api-key": "{env:RAPID_API_KEY}"
      },
      "enabled": true
    }
  }
}

